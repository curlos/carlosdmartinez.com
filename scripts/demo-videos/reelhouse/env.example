# Copy to .env (gitignored) in this folder.
# OBS → Tools → WebSocket Server Settings: enable it, then copy the port and password here.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
# Name of the macOS Screen Capture source (Window Capture) in your OBS scene.
OBS_SOURCE=ReelHouse window
# Recording window size in points; keep it 16:9 and smaller than your display.
WIN=1920x1080
# Optional: a different Chromium-based browser, e.g. /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
EXE=
